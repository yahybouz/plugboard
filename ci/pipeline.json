{
  "schema_version": "1.0",
  "name": "plugboard",
  "description": "CI locale Plugboard (qd-ci, arbre exact du commit) : traduction locale des jobs .gitlab-ci.yml / .github/workflows/ci.yml — environnements figés par requirements-*.lock (--require-hashes) dans {scratch}, ruff et ruff format (dont sdk/python), JSON du registre, pytest + couverture >= 80 %, tests du SDK Python, contrat MCP dans son environnement propre, gitleaks (commits propres à la branche vs main, sinon arbre), bandit, pip-audit, docker build de la cible full déployée (utilisateur app + healthcheck + CLI lancées). Hors CI : sonarqube, smoke-models (planifiés, secrets). Lancer : make ci (ou ci lancer plugboard <ref> sur l'UAT). Linux et macOS : uv et python3.12 cherchés dans le PATH ; caches via UV_CACHE_DIR/DOCKER_HOST transmis.",
  "path": ["/opt/homebrew/bin", "/usr/local/bin", "/usr/bin", "/bin"],
  "env": {
    "LANG": "C.UTF-8",
    "PYTHONNOUSERSITE": "1",
    "PYTHONDONTWRITEBYTECODE": "1",
    "PIP_DISABLE_PIP_VERSION_CHECK": "1",
    "UV_PYTHON_DOWNLOADS": "never",
    "UV_NO_PROGRESS": "1",
    "PLUGBOARD_SKIP_DOTENV": "1",
    "PLUGBOARD_DATA": "{scratch}/data"
  },
  "env_passthrough": ["UV_CACHE_DIR", "DOCKER_HOST", "CI_GIT_DIR", "CI_COMMIT_SHA"],
  "steps": [
    {"id": "env-dev", "description": "Environnement dev + MCP figé (requirements-dev.lock + requirements-mcp.lock, hachages exigés).",
     "argv": ["uv", "venv", "--quiet", "--python", "3.12", "{scratch}/venv"], "timeout_seconds": 300},
    {"id": "deps-dev", "argv": ["uv", "pip", "install", "--quiet", "--python", "{scratch}/venv/bin/python", "--require-hashes",
      "-r", "requirements-dev.lock", "-r", "requirements-mcp.lock"], "timeout_seconds": 900},
    {"id": "ruff", "argv": ["{scratch}/venv/bin/ruff", "check", "--no-cache", "plugboard/", "tests/", "sdk/python/"], "timeout_seconds": 300},
    {"id": "ruff-format", "argv": ["{scratch}/venv/bin/ruff", "format", "--check", "--no-cache", "plugboard/", "tests/", "sdk/python/"], "timeout_seconds": 300},
    {"id": "registre-json", "argv": ["{scratch}/venv/bin/python", "-m", "json.tool", "plugboard/registry.example.json", "{tmp}/registry.json"], "timeout_seconds": 60},
    {"id": "pytest", "description": "pytest + couverture (plancher 80 %, comme COV_MIN de la CI GitLab).",
     "argv": ["{scratch}/venv/bin/python", "-m", "pytest", "tests/", "-q", "-p", "no:cacheprovider", "--cov=plugboard",
      "--cov-report=term", "--cov-report=xml:{artifacts}/coverage.xml", "--cov-fail-under=80", "--junitxml={artifacts}/report.xml"],
     "timeout_seconds": 2400},
    {"id": "pytest-sdk", "description": "Tests du SDK Python (sdk/python), hors couverture, avec sa propre config : pytest tests/ ne peut pas importer plugboard_sdk. pythonpath et asyncio_mode imposés tant que sdk/python/pyproject.toml ne les porte pas.",
     "argv": ["{scratch}/venv/bin/python", "-m", "pytest", "-c", "sdk/python/pyproject.toml", "-o", "pythonpath=.", "-o", "asyncio_mode=auto",
      "sdk/python/tests", "-q", "-p", "no:cacheprovider", "--junitxml={artifacts}/report-sdk.xml"], "timeout_seconds": 300},
    {"id": "env-mcp", "argv": ["uv", "venv", "--quiet", "--python", "3.12", "{scratch}/venv-mcp"], "timeout_seconds": 300},
    {"id": "deps-mcp", "argv": ["uv", "pip", "install", "--quiet", "--python", "{scratch}/venv-mcp/bin/python", "--require-hashes",
      "-r", "requirements-mcp.lock"], "timeout_seconds": 900},
    {"id": "mcp-contract", "argv": ["{scratch}/venv-mcp/bin/python", "scripts/export_contract.py", "--mcp", "--check"], "timeout_seconds": 300},
    {"id": "git-depot", "description": "Dépôt Git du commit exact (objets du dépôt source en lecture seule) pour gitleaks.",
     "argv": ["{python}", "-B", "ci/ci_outils.py", "git-depot", "--ref", "main"], "timeout_seconds": 120},
    {"id": "gitleaks", "argv": ["{python}", "-B", "ci/ci_outils.py", "gitleaks", "--base", "main", "--config", ".gitleaks.toml"], "timeout_seconds": 600},
    {"id": "bandit", "argv": ["{scratch}/venv/bin/bandit", "-q", "-r", "plugboard/", "-x", "tests/", "-ll"], "timeout_seconds": 600},
    {"id": "pip-audit", "description": "CVE des dépendances, un lock par étape (PLU-30) : dev, image (requirements.lock), serveur MCP, décisions. Avis sans correctif sur le runtime décisions (optionnel, hors image) : --ignore-vuln <ID> sur pip-audit-decisions seulement, avec la réserve écrite dans docs/guide/decisions-runtime.md.",
     "argv": ["{scratch}/venv/bin/pip-audit", "--strict", "--progress-spinner", "off", "--disable-pip",
      "--require-hashes", "-r", "requirements-dev.lock"], "timeout_seconds": 600},
    {"id": "pip-audit-image", "argv": ["{scratch}/venv/bin/pip-audit", "--strict", "--progress-spinner", "off", "--disable-pip",
      "--require-hashes", "-r", "requirements.lock"], "timeout_seconds": 600},
    {"id": "pip-audit-mcp", "argv": ["{scratch}/venv/bin/pip-audit", "--strict", "--progress-spinner", "off", "--disable-pip",
      "--require-hashes", "-r", "requirements-mcp.lock"], "timeout_seconds": 600},
    {"id": "pip-audit-decisions", "argv": ["{scratch}/venv/bin/pip-audit", "--strict", "--progress-spinner", "off", "--disable-pip",
      "--require-hashes", "-r", "requirements-decisions.lock"], "timeout_seconds": 600},
    {"id": "docker-build", "description": "Image full non poussée, celle que déploient l'UAT et l'OVH (PLU-20) : utilisateur app + HEALTHCHECK /health, chaque CLI lancée dans l'image sans réseau (agy sur amd64), puis retirée.",
     "argv": ["{python}", "-B", "ci/ci_outils.py", "image-docker", "--nom", "plugboard", "--target", "full", "--user", "app",
      "--healthcheck", "health", "--verifier", "gemini --version", "--verifier", "claude --version",
      "--verifier", "codex --version", "--verifier", "gh --version", "--verifier-amd64", "agy --version"],
     "timeout_seconds": 2400}
  ]
}
