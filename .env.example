# ==============================================================================
# Plugboard configuration
# Copy to .env (or run `make init`, which also fills the keys) and adjust.
# Keep every comment on its own line: python-dotenv reads `KEY=   # note` as
# the value "# note".
# ==============================================================================

# -- Security -----------------------------------------------------------------
# Client API key for the legacy single-key mode. Empty = client auth disabled
# (logged as CRITICAL unless PLUGBOARD_DEV=1). Required when
# PLUGBOARD_STRICT_TENANT=1 is set. Generate: openssl rand -hex 24
API_KEY=
# Admin key for the dashboard and /admin/*. Required: the server does not start
# without it unless PLUGBOARD_DEV=1. Generate: openssl rand -hex 24
ADMIN_KEY=
# Fernet key used to encrypt provider tokens. Empty = a key is generated in
# data/.encryption_key. Never change it once tokens are stored.
ENCRYPTION_KEY=
# 1 = require a TOTP second factor for admin login (only once a secret is
# enrolled: POST /admin/mfa/begin, then POST /admin/mfa/setup {secret, code}).
PLUGBOARD_ADMIN_MFA_REQUIRED=
# 1 = development instance: allows starting without ADMIN_KEY and logs the
# empty API_KEY warning once. Never set it on a deployed instance.
PLUGBOARD_DEV=
# 1 = allow cache calls without a client_id (legacy mode). Empty = strict
# tenant isolation (default).
PLUGBOARD_ALLOW_PERMISSIVE=
# Pad cache hits to at least N milliseconds (timing side-channel). 0 = off.
PLUGBOARD_CACHE_RESPONSE_FLOOR_MS=

# -- Server -------------------------------------------------------------------
# Interface run.py listens on. 127.0.0.1 = local install (dashboard auto-login
# available). Server or LAN deployment: 0.0.0.0 and PLUGBOARD_LOCAL_AUTO_LOGIN=0.
# The Docker image listens on 0.0.0.0 by default; do not pass HOST=127.0.0.1 to
# a container (--env-file / env_file) or the published port becomes unreachable.
HOST=127.0.0.1
# Dashboard auto-login without typing ADMIN_KEY (which must still be set).
# auto = only when run.py listens on 127.0.0.1 / localhost / ::1 (a server
# started directly with uvicorn does not qualify); 1 = force on (personal
# workstation listening on 0.0.0.0); 0 = never. Also requires a browser on the
# same machine opening http://localhost:8765 directly, no proxy, no enforced MFA.
PLUGBOARD_LOCAL_AUTO_LOGIN=auto
PORT=8765
# Requests per minute per IP (0 = unlimited).
RATE_LIMIT=60
# Allowed CORS origins (comma-separated). Set it in production.
CORS_ORIGINS=

# -- Defaults for new client keys ---------------------------------------------
# Applied when POST /admin/keys does not send the field. 0 = unlimited.
PLUGBOARD_DEFAULT_RPM_LIMIT=60
PLUGBOARD_DEFAULT_MONTHLY_LIMIT_USD=10

# -- Chat concurrency cap -----------------------------------------------------
# Maximum chat requests in flight (0 = no cap). Above it: 503 + Retry-After.
PLUGBOARD_MAX_INFLIGHT_CHAT=0
# 0 = fail fast; > 0 = wait up to N seconds for a slot.
PLUGBOARD_INFLIGHT_WAIT_S=0

# -- Provider domain allowlist ------------------------------------------------
# Empty = no restriction. Otherwise POST/PUT /providers refuse a base_url whose
# host is not listed. "api.openai.com" = exact host, ".anthropic.com" = domain
# and subdomains, "localhost" must be listed for local providers.
# Example: .openai.com,.anthropic.com,.googleapis.com,localhost
PLUGBOARD_PROVIDER_DOMAINS_ALLOWED=

# -- Models listed by /v1/models ----------------------------------------------
# Empty or "all" = every discovered model. "curated" = a short list per
# built-in provider (latest Claude per family, GPT-5+, Gemini 3+, selected
# Ollama cloud families).
PLUGBOARD_MODEL_FILTER=
# Models listed per provider (0 = all).
PLUGBOARD_TOP_N_PER_PROVIDER=0

# -- Semantic cache -----------------------------------------------------------
# 1 = enable the near-duplicate cache (MinHash, local, no external call).
PLUGBOARD_SEMANTIC_CACHE=
SEMANTIC_CACHE_TTL=3600
SEMANTIC_CACHE_MAX_SIZE=5000
SEMANTIC_CACHE_THRESHOLD=0.85
# 1 = add an embeddings-based paraphrase match. This sends prompt content to
# the embeddings provider below: check its data-processing terms first.
PLUGBOARD_SEMANTIC_EMBED=
# Provider id (from the dashboard) and model used for embeddings.
PLUGBOARD_EMBED_PROVIDER_ID=
PLUGBOARD_EMBED_MODEL=
PLUGBOARD_EMBED_SIMILARITY_THRESHOLD=0.92
PLUGBOARD_EMBED_TIMEOUT=10

# -- CLI providers (codex, gemini, claude) ------------------------------------
# A CLI runs a client's prompt. It receives an allowlisted environment (PATH,
# HOME, locale, proxies, that CLI's own auth variables) and only reads its
# private spawn directory: ADMIN_KEY, API_KEY and ENCRYPTION_KEY never reach it.
# Extra variable names to pass through, comma-separated (e.g. Bedrock auth:
# AWS_PROFILE,AWS_REGION). Server secrets and PLUGBOARD_* names are refused.
PLUGBOARD_SUBPROCESS_ENV_PASSTHROUGH=
# codex access to the spawn directory: read-only (default) | workspace-write.
# danger-full-access disables the sandbox (not recommended).
PLUGBOARD_CODEX_SANDBOX=
# Fixed spawn directory. Empty = a private temporary directory (mode 0700).
# Everything it contains becomes readable by client prompts.
PLUGBOARD_SUBPROCESS_CWD=

# -- Providers created from the environment -----------------------------------
# Ollama: auto | true | false
OLLAMA_URL=http://localhost:11434
OLLAMA_ENABLED=auto
# Ollama cloud families added automatically (comma-separated, or all).
# PLUGBOARD_OLLAMA_CLOUD_FAMILIES=deepseek,kimi,qwen,glm,gemma,nemotron,minimax,gpt-oss,gemini,beam

# Google OAuth desktop client used for Gemini logins and token refresh. Not
# shipped with Plugboard: see docs/guide/providers-and-subscriptions.md.
GEMINI_OAUTH_CLIENT_ID=
GEMINI_OAUTH_CLIENT_SECRET=

# -- Provider catalog (docs/guide/providers-and-subscriptions.md) --------------
# off = no download of the models.dev catalog (only built-in presets).
PLUGBOARD_CATALOG=
# Mirror of https://models.dev/api.json. Leave commented: an empty value turns the catalog off.
# PLUGBOARD_CATALOG_URL=https://models.dev/api.json
# Comma-separated models.dev provider ids to hide.
PLUGBOARD_CATALOG_EXCLUDE=

# -- Pricing sources (docs/guide/pricing.md#sources) ---------------------------
# Sources, highest priority first. Empty = external,official,provider_native,models_dev,litellm,known
# (or external,official,known when PLUGBOARD_PRICING_SOURCE_URL is set).
PLUGBOARD_PRICING_SOURCES=
# Days after the official price table's last check before it is reported stale. Empty = 35.
PLUGBOARD_OFFICIAL_PRICES_MAX_AGE_DAYS=
# Your own JSON price document (the "external" source).
PLUGBOARD_PRICING_SOURCE_URL=
# Percent change above which a third-party price waits for review. Empty = 20.
PLUGBOARD_PRICE_DRIFT_PCT=
# review (default: queue large changes, not billed until applied) or apply.
PLUGBOARD_PRICE_DRIFT_ACTION=
# 1 = let a model read prices from provider pages (suggestions only, off by default).
PLUGBOARD_LLM_PRICING=
# Pricing pages: provider-id=https://...;other-id=https://...
PLUGBOARD_LLM_PRICING_URLS=
# Daily budget in USD for those calls. Empty = 0.50.
PLUGBOARD_LLM_PRICING_MAX_USD=

# -- Model catalog refresh and probes -----------------------------------------
# 1 = disable the model-list refresh.
MODEL_AVAILABILITY_SCHEDULER_DISABLED=
# Hours between price updates and model-list refreshes (1-24). Empty = 6; 0 = daily.
PLUGBOARD_PRICING_REFRESH_INTERVAL_H=
PLUGBOARD_MODEL_AVAILABILITY_INTERVAL_H=
# Minimum hours between two refreshes of a CLI provider. Empty = 24.
PLUGBOARD_MODEL_AVAILABILITY_CLI_INTERVAL_H=
# Refreshes in a row without a model before it is removed. Empty = 2.
PLUGBOARD_MODEL_REMOVAL_PASSES=
# Hour (UTC) of the refresh in daily mode. Empty = one hour after the pricing job.
MODEL_AVAILABILITY_DAILY_HOUR_UTC=
MODEL_AVAILABILITY_BOOTSTRAP_DELAY_S=8
MODEL_AVAILABILITY_UPDATE_TIMEOUT_S=900
# CLIs probed during the refresh: codex, claude, gemini, agy, ollama or all.
PLUGBOARD_MODEL_REFRESH_PROBE_KINDS=codex,claude,gemini,agy,ollama
# Models listed per family: latest (newest versions only) or all.
PLUGBOARD_MODEL_EXPOSE=latest
PLUGBOARD_MODEL_EXPOSE_VERSIONS=2
PLUGBOARD_MODEL_REFRESH_MAX_PROBES=40
PLUGBOARD_MODEL_REFRESH_TIMEOUT_S=45
# true = probe connectivity at every start.
PLUGBOARD_PROBE_ON_BOOT=true
PLUGBOARD_PROBE_TOTAL_TIMEOUT_S=60
PLUGBOARD_OLLAMA_RECHECK_INTERVAL_S=300
# Minimum seconds between two POST /admin/models/refresh calls.
PLUGBOARD_REFRESH_COOLDOWN_S=60
# true = ignore data/model_status.json when listing models.
PLUGBOARD_IGNORE_MODEL_STATUS=

# -- Data and integrations ----------------------------------------------------
# Data directory (providers, keys, pricing grids, logs). Empty = <project>/data.
PLUGBOARD_DATA=
# Update registry pushed to client projects over MCP. Empty = data/registry.json.
# Format: plugboard/registry.example.json
PLUGBOARD_REGISTRY_PATH=
# Python used by scheduled jobs. Empty = the server's own interpreter.
PLUGBOARD_JOB_PYTHON=

# -- Watchdog -----------------------------------------------------------------
WATCHDOG_INTERVAL=30
WATCHDOG_FAILURES=3
WATCHDOG_RESTART_COOLDOWN=120
WATCHDOG_MAX_RESTARTS=5

# -- Alerts -------------------------------------------------------------------
# Webhook (Slack, Discord...) for provider-down alerts.
ALERT_WEBHOOK_URL=
# Maximum models.changed / pricing.changed webhooks per update. Empty = 50.
PLUGBOARD_WEBHOOK_MAX_PER_RUN=
ALERT_FAILURE_THRESHOLD=3

# ==============================================================================
# Production checklist
# ==============================================================================
# [ ] ADMIN_KEY (and API_KEY if used) set to random values (openssl rand -hex 24)
# [ ] ENCRYPTION_KEY set, or data/.encryption_key backed up
# [ ] HOST=0.0.0.0 behind a reverse proxy with TLS, PLUGBOARD_LOCAL_AUTO_LOGIN=0
# [ ] CORS_ORIGINS restricted to known origins
# [ ] Firewall: only the reverse proxy port is open, not 8765
# [ ] .env and data/ are never committed
# [ ] Keys rotated regularly

# Typed decisions: separately provisioned client keys require exact
# allowed_decision_models, e.g. ["jev", "laya", "laya-multilingual"].
# Absent/null/empty policy denies all decisions, including local auto-login.
# Deliberately configure a TypeSafe credential server-side for real Jev calls.
PLUGBOARD_JEV_API_KEY=
# Jev is billed at TypeSafe's official price ($0.042 per million input tokens,
# output free) from the token usage it reports; Laya is free. No setting.
# Optional isolated local runtime; never point this to the gateway environment.
# Download explicitly first; all assets/source revisions/hashes are pinned.
# See docs/guide/decisions-runtime.md. No inference-time downloads.
PLUGBOARD_DECISION_PYTHON=
PLUGBOARD_DECISION_ASSETS=
