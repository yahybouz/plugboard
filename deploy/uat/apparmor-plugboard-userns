#include <tunables/global>
# INC-2/BUG-43 : docker-default + mount autorise (sandbox bwrap de codex dans un userns).
# Les capacites restent a zero (cap_drop ALL) : mount n agit que dans le userns cree par bwrap.
profile plugboard-userns flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>
  network,
  capability,
  file,
  umount,
  mount,
  pivot_root,
  userns,
  signal (receive) peer=unconfined,
  signal (send,receive) peer=plugboard-userns,
  ptrace (trace,read,tracedby,readby) peer=plugboard-userns,
  deny @{PROC}/* w,
  deny @{PROC}/{[^1-9],[^1-9][^0-9],[^1-9s][^0-9y][^0-9s],[^1-9][^0-9][^0-9][^0-9]*}/** w,
  deny @{PROC}/sys/[^k]** w,
  deny @{PROC}/sys/kernel/{?,??,[^s][^h][^m]**} w,
  deny @{PROC}/sysrq-trigger rwklx,
  deny @{PROC}/kcore rwklx,
  deny /sys/[^f]*/** wklx,
  deny /sys/f[^s]*/** wklx,
  deny /sys/fs/[^c]*/** wklx,
  deny /sys/fs/c[^g]*/** wklx,
  deny /sys/fs/cg[^r]*/** wklx,
  deny /sys/firmware/** rwklx,
  deny /sys/devices/virtual/powercap/** rwklx,
  deny /sys/kernel/security/** rwklx,
}
